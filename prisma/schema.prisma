datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum BatchStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE
  TESTER
  LOSS
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum SaleStatus {
  COMPLETED
  PARTIAL
  UNPAID
  VOIDED
  REFUNDED
}


enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  CARD
  OTHER
}

enum ExpenseCategory {
  TRANSPORT
  DELIVERY
  PACKAGING
  MARKETING
  RESTOCKING
  OPERATIONS
  OTHER
}

enum AllocationType {
  SAVINGS
  NEEDS
  WANTS
}

enum SavingsTransactionType {
  DEPOSIT
  WITHDRAWAL
  ADJUSTMENT
}

enum Role {
  OWNER
  WORKER
}

enum CancellationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                   String                   @id @default(cuid())
  name                 String
  email                String                   @unique
  passwordHash         String
  role                 Role                     @default(WORKER)
  isActive             Boolean                  @default(true)
  businessId           String?
  business             Business?                @relation("BusinessMembers", fields: [businessId], references: [id], onDelete: SetNull)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  businesses           Business[]               @relation("BusinessOwner")
  sessions             Session[]
  createdSales         Sale[]                   @relation("SaleCreator")
  editedSales          Sale[]                   @relation("SaleLastEditor")
  collectedPayments    DebtPayment[]            @relation("PaymentCollector")
  cancellationRequests SaleCancellationRequest[] @relation("CancellationRequester")
  reviewedCancellations SaleCancellationRequest[] @relation("CancellationReviewer")
  auditLogs            AuditLog[]
  sentInvitations      WorkerInvitation[]       @relation("WorkerInviter")
  createdBankDeposits  BankDeposit[]            @relation("BankDepositCreator")
  createdFeedbacks     CustomerFeedback[]       @relation("FeedbackCreator")

  @@index([businessId])
  @@index([role])
  @@index([isActive])
}

model Business {
  id                   String                 @id @default(cuid())
  name                 String
  phone                String?
  address              String?
  description          String?
  currency             String                 @default("GHS")
  ownerId              String
  owner                User                   @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  members              User[]                 @relation("BusinessMembers")
  products             Product[]
  batches              Batch[]
  sales                Sale[]
  customers            Customer[]
  expenses             Expense[]
  profitAllocations    ProfitAllocation[]
  savingsTransactions  SavingsTransaction[]
  inventoryTxns        InventoryTransaction[]
  suppliers            Supplier[]
  debtPayments         DebtPayment[]
  settings             Setting?
  notifications        Notification[]
  notificationSetting  NotificationSetting?
  automationExecutions AutomationExecution[]
  whatsAppLogs         WhatsAppLog[]
  pushSubscriptions    PushSubscription[]
  pushDeliveryLogs     PushDeliveryLog[]
  workerInvitations    WorkerInvitation[]
  cancellationRequests SaleCancellationRequest[]
  auditLogs            AuditLog[]
  bankDeposits         BankDeposit[]
  depositAllocations   DepositAllocation[]
  feedbacks            CustomerFeedback[]
}


model Product {
  id                  String                 @id @default(cuid())
  businessId          String
  business            Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                String
  sku                 String?
  barcode             String?
  description         String?
  category            String?
  brand               String?
  size                String?
  sellingPrice        Decimal                @db.Decimal(12, 2)
  defaultCostPrice    Decimal                @db.Decimal(12, 2)
  lowStockThreshold   Int                    @default(3)
  isActive            Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  batchItems          BatchItem[]
  saleItems           SaleItem[]
  inventoryTxns       InventoryTransaction[]
  feedbacks           CustomerFeedback[]

  @@index([businessId])
  @@index([businessId, sku])
  @@index([businessId, barcode])
  @@index([businessId, isActive])
}

model Batch {
  id              String                 @id @default(cuid())
  businessId      String
  business        Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierId      String?
  supplier        Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  reference       String
  purchaseDate    DateTime
  status          BatchStatus            @default(ACTIVE)
  purchaseCost    Decimal                @db.Decimal(12, 2)
  additionalCosts Decimal                @default(0) @db.Decimal(12, 2)
  totalInvestment Decimal                @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  batchItems      BatchItem[]
  saleItems       SaleItem[]
  expenses        Expense[]
  inventoryTxns   InventoryTransaction[]
  feedbacks       CustomerFeedback[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, purchaseDate])
  @@index([businessId, supplierId])
}

model BatchItem {
  id                String   @id @default(cuid())
  batchId           String
  batch             Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantityPurchased Int
  unitCost          Decimal  @db.Decimal(12, 2)
  totalCost         Decimal  @db.Decimal(12, 2)
  quantityRemaining Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([batchId])
  @@index([batchId, productId])
}

model InventoryTransaction {
  id          String                   @id @default(cuid())
  businessId  String
  business    Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId   String
  product     Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchId     String?
  batch       Batch?                   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  type        InventoryTransactionType
  quantity    Int
  referenceId String?
  note        String?
  createdAt   DateTime                 @default(now())

  @@index([businessId])
  @@index([businessId, productId])
  @@index([businessId, createdAt])
}

model Supplier {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  batches       Batch[]

  @@index([businessId])
  @@index([businessId, name])
}

model Customer {
  id           String        @id @default(cuid())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  email        String?
  notes        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sales        Sale[]
  debtPayments DebtPayment[]
  whatsAppLogs WhatsAppLog[]
  feedbacks    CustomerFeedback[]

  @@index([businessId])
  @@index([businessId, name])
}

model Sale {
  id                  String                   @id @default(cuid())
  businessId          String
  business            Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId          String?
  customer            Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  creatorId           String?
  creator             User?                    @relation("SaleCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  lastEditorId        String?
  lastEditor          User?                    @relation("SaleLastEditor", fields: [lastEditorId], references: [id], onDelete: SetNull)
  lastEditedAt        DateTime?
  saleDate            DateTime                 @default(now())
  subtotal            Decimal                  @db.Decimal(12, 2)
  discount            Decimal                  @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal                  @db.Decimal(12, 2)
  totalCost           Decimal                  @db.Decimal(12, 2)
  grossProfit         Decimal                  @db.Decimal(12, 2)
  paymentMethod       PaymentMethod            @default(CASH)
  paymentStatus       PaymentStatus            @default(PAID)
  amountPaid          Decimal                  @default(0) @db.Decimal(12, 2)
  balanceDue          Decimal                  @default(0) @db.Decimal(12, 2)
  dueDate             DateTime?
  status              SaleStatus               @default(COMPLETED)
  notes               String?
  editHistory         Json?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  saleItems           SaleItem[]
  debtPayments        DebtPayment[]
  cancellationRequest SaleCancellationRequest?
  feedbacks           CustomerFeedback[]

  @@index([businessId])
  @@index([businessId, saleDate])
  @@index([businessId, dueDate])
  @@index([businessId, customerId])
  @@index([businessId, status])
  @@index([businessId, paymentStatus])
  @@index([businessId, creatorId])
}

model DebtPayment {
  id                  String        @id @default(cuid())
  businessId          String
  business            Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId          String
  customer            Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  collectorId         String?
  collector           User?         @relation("PaymentCollector", fields: [collectorId], references: [id], onDelete: SetNull)
  saleId              String?
  sale                Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  amount              Decimal       @db.Decimal(12, 2)
  paymentMethod       PaymentMethod @default(CASH)
  idempotencyKey      String?       @unique
  allocationBreakdown Json?
  notes               String?
  paymentDate         DateTime      @default(now())
  createdAt           DateTime      @default(now())

  @@index([businessId])
  @@index([businessId, customerId])
  @@index([businessId, paymentDate])
  @@index([businessId, collectorId])
}


model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  unitCost  Decimal  @db.Decimal(12, 2)
  revenue   Decimal  @db.Decimal(12, 2)
  cost      Decimal  @db.Decimal(12, 2)
  profit    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([saleId, productId])
  @@index([batchId])
}

model Expense {
  id          String          @id @default(cuid())
  businessId  String
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  batchId     String?
  batch       Batch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(12, 2)
  expenseDate DateTime        @default(now())
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([businessId])
  @@index([businessId, expenseDate])
  @@index([businessId, batchId])
  @@index([businessId, category])
}

model ProfitAllocation {
  id             String         @id @default(cuid())
  businessId     String
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amount         Decimal        @db.Decimal(12, 2)
  type           AllocationType
  source         String?
  allocationDate DateTime       @default(now())
  notes          String?
  createdAt      DateTime       @default(now())

  @@index([businessId])
  @@index([businessId, allocationDate])
  @@index([businessId, type])
}

model SavingsTransaction {
  id          String                 @id @default(cuid())
  businessId  String
  business    Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type        SavingsTransactionType
  amount      Decimal                @db.Decimal(12, 2)
  referenceId String?
  description String?
  createdAt   DateTime               @default(now())

  @@index([businessId])
  @@index([businessId, createdAt])
}

model Setting {
  id                   String        @id @default(cuid())
  businessId           String        @unique
  business             Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lowStockThreshold    Int           @default(3)
  currency             String        @default("GHS")
  defaultPaymentMethod PaymentMethod @default(CASH)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Notification {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String?
  type        String
  category    String
  severity    String    @default("INFO")
  title       String
  message     String
  actionLabel String?
  actionUrl   String?
  entityType  String?
  entityId    String?
  metadata    Json?
  dedupeKey   String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  @@index([businessId])
  @@index([businessId, isRead, createdAt])
  @@index([businessId, createdAt])
  @@index([dedupeKey])
}

model NotificationSetting {
  id                     String   @id @default(cuid())
  businessId             String   @unique
  business               Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lowStockEnabled        Boolean  @default(true)
  outOfStockEnabled      Boolean  @default(true)
  stockRestoredEnabled   Boolean  @default(true)
  saleCompletedEnabled   Boolean  @default(true)
  partialPaymentEnabled Boolean  @default(true)
  unpaidSaleEnabled      Boolean  @default(true)
  paymentReceivedEnabled Boolean  @default(true)
  batchCreatedEnabled    Boolean  @default(true)
  batchCompletedEnabled  Boolean  @default(true)
  expenseEnabled         Boolean  @default(true)
  largeExpenseThreshold  Decimal  @default(1000) @db.Decimal(12, 2)
  batchNearCompletionThreshold Decimal @default(10) @db.Decimal(5, 2)
  dormantCustomerDays    Int      @default(30)
  dailySummaryEnabled    Boolean  @default(true)
  weeklySummaryEnabled   Boolean  @default(true)
  profitAllocatedEnabled Boolean  @default(true)
  securityEnabled        Boolean  @default(true)
  pushEnabled               Boolean  @default(true)
  upcomingRemindersEnabled  Boolean  @default(true)
  upcomingDaysAdvance       Int      @default(1)
  dueTodayEnabled           Boolean  @default(true)
  overdueEnabled            Boolean  @default(true)
  overdueIntervalDays       Int      @default(3)
  showCustomerDetailsInPush Boolean  @default(false)
  quietHoursStart           String?
  quietHoursEnd             String?
  timezone                  String   @default("Africa/Accra")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model AutomationExecution {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  eventType   String
  eventId     String?
  actionType  String
  status      String    @default("COMPLETED")
  dedupeKey   String?
  error       String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  executedAt  DateTime? @default(now())

  @@index([businessId])
  @@index([businessId, eventType])
  @@index([dedupeKey])
}

enum WhatsAppDeliveryStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum WhatsAppMessageType {
  PAYMENT_REMINDER
  DEBT_SETTLED
  SALE_RECEIPT
  PAYMENT_RECEIPT
}

model WhatsAppLog {
  id           String                 @id @default(cuid())
  businessId   String
  business     Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messageType  WhatsAppMessageType
  phone        String
  message      String
  status       WhatsAppDeliveryStatus @default(QUEUED)
  error        String?
  dedupeKey    String?
  sentAt       DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime               @default(now())

  @@index([businessId])
  @@index([businessId, customerId])
  @@index([businessId, status])
  @@index([dedupeKey])
}

model PushSubscription {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String?
  endpoint    String    @unique
  p256dh      String
  auth        String
  userAgent   String?
  deviceName  String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([businessId])
  @@index([businessId, isActive])
}

model PushDeliveryLog {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  notificationType String
  entityType      String?
  entityId        String?
  customerId      String?
  saleId          String?
  scheduledDate   DateTime?
  dedupeKey       String    @unique
  title           String
  body            String
  status          String    @default("SENT")
  recipientCount  Int       @default(0)
  error           String?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([businessId])
  @@index([businessId, notificationType])
  @@index([businessId, createdAt])
  @@index([dedupeKey])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model WorkerInvitation {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email       String
  name        String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  invitedById String
  invitedBy   User      @relation("WorkerInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([businessId])
  @@index([email])
  @@index([tokenHash])
}

model SaleCancellationRequest {
  id              String             @id @default(cuid())
  businessId      String
  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleId          String             @unique
  sale            Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  requesterId     String
  requester       User               @relation("CancellationRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reason          String
  status          CancellationStatus @default(PENDING)
  reviewerId      String?
  reviewer        User?              @relation("CancellationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([businessId, status])
  @@index([requesterId])
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, action])
  @@index([entityType, entityId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([tokenHash])
}

model BankDeposit {
  id             String              @id @default(cuid())
  businessId     String
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?               @relation("BankDepositCreator", fields: [createdById], references: [id], onDelete: SetNull)
  amount         Decimal             @db.Decimal(12, 2)
  depositDate    DateTime            @default(now())
  reference      String?
  notes          String?
  idempotencyKey String?             @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  allocations    DepositAllocation[]

  @@index([businessId])
  @@index([businessId, depositDate])
  @@index([businessId, createdAt])
}

model DepositAllocation {
  id             String      @id @default(cuid())
  businessId     String
  business       Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  depositId      String
  deposit        BankDeposit @relation(fields: [depositId], references: [id], onDelete: Cascade)
  amount         Decimal     @db.Decimal(12, 2)
  collectionType String
  collectionId   String
  collectionDate DateTime
  createdAt      DateTime    @default(now())

  @@index([businessId])
  @@index([depositId])
  @@index([collectionType, collectionId])
  @@index([businessId, collectionDate])
}

enum FeedbackSource {
  PHONE
  WHATSAPP
  IN_PERSON
  OTHER
}

enum FeedbackCategory {
  LONGEVITY
  FRAGRANCE_SCENT
  PROJECTION
  PACKAGING
  VALUE_FOR_MONEY
  DELIVERY_SERVICE
  POSITIVE_GENERAL
  COMPLAINT
  OTHER
}

enum FeedbackStatus {
  NEW
  REVIEWING
  FOLLOW_UP_NEEDED
  RESOLVED
}

model CustomerFeedback {
  id            String           @id @default(cuid())
  businessId    String
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  productId     String?
  product       Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  saleId        String?
  sale          Sale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)
  batchId       String?
  batch         Batch?           @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?            @relation("FeedbackCreator", fields: [createdById], references: [id], onDelete: SetNull)
  source        FeedbackSource   @default(OTHER)
  category      FeedbackCategory @default(OTHER)
  comments      String
  rating        Int?
  feedbackDate  DateTime         @default(now())
  status        FeedbackStatus   @default(NEW)
  internalNotes String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([businessId])
  @@index([businessId, feedbackDate])
  @@index([businessId, productId])
  @@index([businessId, customerId])
  @@index([businessId, status])
  @@index([businessId, createdById])
  @@index([businessId, category])
}


